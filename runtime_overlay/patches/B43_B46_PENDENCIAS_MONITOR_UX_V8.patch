--- a/src/axiom_tools/web/static/css/processing-hub.css
+++ b/src/axiom_tools/web/static/css/processing-hub.css
@@
-.ax-monitor-summary{grid-template-columns:repeat(6,minmax(120px,1fr))}
+.ax-monitor-summary{grid-template-columns:repeat(4,minmax(120px,1fr))}
@@
-.ax-pending-filters{display:grid;grid-template-columns:minmax(180px,1.25fr) 170px 130px 130px 170px 100px auto auto;...}
+.ax-pending-filters{display:grid;grid-template-columns:150px minmax(200px,1.25fr) 170px 135px 110px auto auto;...}
@@
-.ax-history-filters--audit{display:grid!important;grid-template-columns:minmax(160px,1.25fr) minmax(115px,.7fr) minmax(125px,.78fr) minmax(125px,.8fr) minmax(115px,.7fr) 118px auto!important;...}
+.ax-history-filters--audit{display:grid!important;grid-template-columns:150px minmax(180px,1.25fr) minmax(145px,.8fr) minmax(145px,.8fr) auto!important;...}
+
+/* V8 — competência como eixo; PROC e pipeline permanecem detalhes técnicos. */
+.ax-pending-scope{display:inline-flex;align-items:center;gap:.35rem;margin-top:.3rem;color:var(--bs-secondary-color);font-size:.68rem}
+.ax-pending-advanced,.ax-monitor-advanced{grid-column:1/-1;border-top:1px dashed var(--bs-border-color);padding-top:.35rem;margin-top:.1rem}
+.ax-pending-advanced summary,.ax-monitor-advanced summary{cursor:pointer;color:var(--bs-secondary-color);font-size:.66rem;font-weight:700;list-style:none;display:inline-flex;align-items:center;gap:.35rem}
+.ax-monitor-tech{margin-top:.65rem;padding:.55rem .7rem}
+.ax-monitor-tech>summary{cursor:pointer;list-style:none}
+.ax-monitor-tech>summary>span{display:flex;align-items:center;gap:.5rem}
+.ax-monitor-tech>summary small{margin-left:auto;color:var(--bs-secondary-color);font-weight:400}
