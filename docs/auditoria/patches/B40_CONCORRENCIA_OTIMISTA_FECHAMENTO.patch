+def _atualizar_mensal_otimista(con, competencia, cliente_id, revisao_esperada, set_sql, params):
+    cur = con.execute(
+        f"UPDATE fechamento_mensal_cliente SET {set_sql}, revisao_estado=revisao_estado+1, "
+        "atualizado_em=datetime('now','localtime') "
+        "WHERE competencia=? AND cliente_id=? AND revisao_estado=?",
+        (*params, competencia, int(cliente_id), int(revisao_esperada)),
+    )
+    if int(cur.rowcount or 0) != 1:
+        con.rollback()
+        raise ConflitoEstadoMensal(
+            f"Estado mensal alterado por outra rotina: {competencia} cliente {int(cliente_id)}. Recarregue antes de gravar."
+        )
