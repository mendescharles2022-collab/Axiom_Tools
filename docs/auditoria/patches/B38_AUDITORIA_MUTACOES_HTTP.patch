+                    descricao=f"{request.method} {request.path} -> HTTP {response.status_code}",
+                    detalhes={
+                        "request_id": request_id,
+                        "endpoint": request.endpoint,
+                        "status_http": int(response.status_code or 0),
+                        "campos_formulario": sorted(str(k) for k in request.form.keys()),
+                    },
+                    sucesso=sucesso,
+                    nivel="INFO" if sucesso else "ATENCAO",
+                )
+                if request_id:
+                    response.headers["X-Axiom-Request-ID"] = request_id
