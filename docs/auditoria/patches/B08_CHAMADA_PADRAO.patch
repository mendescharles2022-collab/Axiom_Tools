+def perfil_cliente(con: sqlite3.Connection, cliente_id: int) -> dict | None:
+    garantir_schema(con)
+    row=con.execute("SELECT * FROM fechamento_cliente_perfil WHERE cliente_id=?",(int(cliente_id),)).fetchone()
+    return dict(row) if row else None
+
+
+def salvar_perfil_cliente(con: sqlite3.Connection, cliente_id: int, *, participa_ciclo: bool, chamada_padrao: int = 1, origem: str = "MANUAL") -> dict:
+    """Persiste participação e chamada padrão sem misturar com a decisão mensal."""
+    garantir_schema(con); cliente_id=int(cliente_id); chamada_padrao=int(chamada_padrao or 1)
+    if chamada_padrao < 1 or chamada_padrao > 20:
+        raise ValueError("A chamada padrão deve estar entre 1 e 20.")
+    if not con.execute("SELECT 1 FROM clientes WHERE id=?",(cliente_id,)).fetchone():
+        raise ValueError("Cliente não encontrado.")
+    old=con.execute("SELECT participa_ciclo,chamada_padrao FROM fechamento_cliente_perfil WHERE cliente_id=?",(cliente_id,)).fetchone()
+    anterior_participa=int(old["participa_ciclo"] or 0) if old else None
+    anterior_chamada=int(old["chamada_padrao"] or 1) if old else None
+    novo_participa=1 if participa_ciclo else 0
+    con.execute("""INSERT INTO fechamento_cliente_perfil(cliente_id,participa_ciclo,chamada_padrao,origem)
+        VALUES(?,?,?,?) ON CONFLICT(cliente_id) DO UPDATE SET
+        participa_ciclo=excluded.participa_ciclo,chamada_padrao=excluded.chamada_padrao,origem=excluded.origem,
+        atualizado_em=datetime('now','localtime')""",(cliente_id,novo_participa,chamada_padrao,str(origem or "MANUAL")[:200]))
+    if old is None or anterior_participa!=novo_participa or anterior_chamada!=chamada_padrao:
+        con.execute("""INSERT INTO fechamento_cliente_perfil_historico
+            (cliente_id,participa_anterior,participa_novo,chamada_anterior,chamada_nova,origem,detalhe)
+            VALUES(?,?,?,?,?,?,?)""",(cliente_id,anterior_participa,novo_participa,anterior_chamada,chamada_padrao,
+            str(origem or "MANUAL")[:200],f"Perfil de fechamento atualizado; chamada padrão {chamada_padrao}."))
+    con.commit()
+    return perfil_cliente(con,cliente_id) or {}
+
+
+def aplicar_chamada_padrao_competencia(con: sqlite3.Connection, competencia: str, cliente_ids: list[int] | None = None) -> int:
+    """Aplica chamada padrão apenas em linhas mensais ainda não concluídas/retificadas."""
+    garantir_schema(con); competencia=validar_competencia(competencia)
+    params:[object]=[competencia]
+    filtro=""
+    if cliente_ids is not None:
+        ids=sorted({int(x) for x in cliente_ids if int(x)>0})
+        if not ids: return 0
+        filtro=f" AND f.cliente_id IN ({','.join('?' for _ in ids)})"; params.extend(ids)
+    rows=con.execute(f"""SELECT f.cliente_id,f.status,f.chamada,f.impedimento_tipo,COALESCE(fp.chamada_padrao,1) chamada_padrao
+        FROM fechamento_mensal_cliente f JOIN fechamento_cliente_perfil fp ON fp.cliente_id=f.cliente_id
+        WHERE f.competencia=? AND f.status IN ('PRONTA','ADIADA') AND COALESCE(fp.participa_ciclo,0)=1{filtro}""",params).fetchall()
+    alterados=0
+    for row in rows:
+        cid=int(row["cliente_id"]); chamada=max(1,int(row["chamada_padrao"] or 1))
+        novo_status='PRONTA' if chamada<=1 else 'ADIADA'
+        tipo=None if novo_status=='PRONTA' else 'CHAMADA_PADRAO'
+        obs=None if novo_status=='PRONTA' else f"Aguardando {chamada}ª chamada conforme perfil permanente."
+        if str(row["status"])==novo_status and int(row["chamada"] or 1)==chamada and str(row["impedimento_tipo"] or '')==str(tipo or ''):
+            continue
+        con.execute("""UPDATE fechamento_mensal_cliente SET status=?,chamada=?,impedimento_tipo=?,impedimento_observacao=?,
+            atualizado_em=datetime('now','localtime') WHERE competencia=? AND cliente_id=?""",
+            (novo_status,chamada,tipo,obs,competencia,cid))
+        _registrar(con,competencia,'APLICAR_CHAMADA_PADRAO',cid,chamada,row['status'],novo_status,obs or 'Chamada padrão 1 aplicada.')
+        alterados+=1
+    con.commit(); return alterados
+
