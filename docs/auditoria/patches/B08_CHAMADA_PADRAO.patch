+from __future__ import annotations
+
+import shutil
+import sqlite3
+import tempfile
+import unittest
+from pathlib import Path
+
+from axiom_tools.modules.closing import service as closing
+
+SOURCE_DB = Path('/mnt/data/axiom_tools_recovered_snapshot/Axiom_Tools/data/axiom_tools.db')
+
+
+def make_con() -> sqlite3.Connection:
+    con = sqlite3.connect(':memory:')
+    con.row_factory = sqlite3.Row
+    con.execute("CREATE TABLE clientes(id INTEGER PRIMARY KEY,nome TEXT,nome_apresentacao TEXT,documento TEXT,situacao TEXT DEFAULT 'ATIVO')")
+    con.execute("CREATE TABLE cliente_parametros(cliente_id INTEGER PRIMARY KEY,movimento_folha TEXT)")
+    con.execute("INSERT INTO clientes(id,nome,situacao) VALUES(1,'Cliente 1','ATIVO')")
+    con.execute("INSERT INTO cliente_parametros(cliente_id,movimento_folha) VALUES(1,'COM_MOVIMENTO')")
+    closing.garantir_schema(con)
+    return con
+
+
+class ClosingCallsV8Tests(unittest.TestCase):
+    def test_profile_persists_default_call_and_history(self):
+        con = make_con()
+        result = closing.salvar_perfil_cliente(con, 1, participa_ciclo=True, chamada_padrao=2, origem='TESTE')
+        self.assertEqual(result['chamada_padrao'], 2)
+        hist = con.execute("SELECT * FROM fechamento_cliente_perfil_historico WHERE cliente_id=1 ORDER BY id DESC LIMIT 1").fetchone()
+        self.assertEqual((hist['participa_novo'], hist['chamada_nova'], hist['origem']), (1, 2, 'TESTE'))
+        con.close()
+
+    def test_second_call_client_is_not_ready_in_first_call(self):
+        con = make_con()
+        closing.salvar_perfil_cliente(con, 1, participa_ciclo=True, chamada_padrao=2, origem='TESTE')
+        con.execute("INSERT INTO fechamento_mensal(competencia,chamada_atual,status) VALUES('09/2026',1,'ABERTO')")
+        inserted = closing.sincronizar_clientes_ativos(con, '09/2026')
+        self.assertEqual(inserted, 1)
+        row = con.execute("SELECT status,chamada,impedimento_tipo FROM fechamento_mensal_cliente WHERE competencia='09/2026' AND cliente_id=1").fetchone()
+        self.assertEqual((row['status'], row['chamada'], row['impedimento_tipo']), ('ADIADA', 2, 'CHAMADA_PADRAO'))
+        self.assertNotIn(1, closing.clientes_conferencia_ids(con, '09/2026'))
+        con.close()
+
+    def test_opening_second_call_releases_default_second_call_client(self):
+        con = make_con()
+        closing.salvar_perfil_cliente(con, 1, participa_ciclo=True, chamada_padrao=2, origem='TESTE')
+        con.execute("INSERT INTO fechamento_mensal(competencia,chamada_atual,status) VALUES('09/2026',1,'ABERTO')")
+        closing.sincronizar_clientes_ativos(con, '09/2026')
+        new_call = closing.abrir_proxima_chamada(con, '09/2026')
+        row = con.execute("SELECT status,chamada,impedimento_tipo FROM fechamento_mensal_cliente WHERE competencia='09/2026' AND cliente_id=1").fetchone()
+        self.assertEqual(new_call, 2)
+        self.assertEqual((row['status'], row['chamada'], row['impedimento_tipo']), ('PRONTA', 2, None))
+        con.close()
+
+    def test_apply_default_call_repairs_untouched_current_cycle(self):
+        con = make_con()
+        closing.salvar_perfil_cliente(con, 1, participa_ciclo=True, chamada_padrao=2, origem='TESTE')
+        con.execute("INSERT INTO fechamento_mensal(competencia,chamada_atual,status) VALUES('08/2026',1,'ABERTO')")
+        con.execute("INSERT INTO fechamento_mensal_cliente(competencia,cliente_id,chamada,status,movimento_competencia) VALUES('08/2026',1,1,'PRONTA','COM_MOVIMENTO')")
+        changed = closing.aplicar_chamada_padrao_competencia(con, '08/2026', [1])
+        row = con.execute("SELECT status,chamada,impedimento_tipo FROM fechamento_mensal_cliente WHERE competencia='08/2026' AND cliente_id=1").fetchone()
+        self.assertEqual(changed, 1)
+        self.assertEqual((row['status'], row['chamada'], row['impedimento_tipo']), ('ADIADA', 2, 'CHAMADA_PADRAO'))
+        hist = con.execute("SELECT acao,status_anterior,status_novo FROM fechamento_mensal_historico WHERE cliente_id=1 ORDER BY id DESC LIMIT 1").fetchone()
+        self.assertEqual((hist['acao'], hist['status_anterior'], hist['status_novo']), ('APLICAR_CHAMADA_PADRAO', 'PRONTA', 'ADIADA'))
+        con.close()
+
+    def test_real_tl_snapshot_can_be_repaired_without_guessing_id(self):
+        with tempfile.TemporaryDirectory() as td:
+            db = Path(td) / 'axiom_tools.db'
+            shutil.copy2(SOURCE_DB, db)
+            con = sqlite3.connect(db)
+            con.row_factory = sqlite3.Row
+            closing.garantir_schema(con)
+            cliente = con.execute("""SELECT id,COALESCE(nome_apresentacao,nome) nome FROM clientes
+                WHERE lower(COALESCE(nome_apresentacao,nome))='t l empreendimentos agricolas ltda' LIMIT 1""").fetchone()
+            self.assertIsNotNone(cliente)
+            cid = int(cliente['id'])
+            closing.salvar_perfil_cliente(con, cid, participa_ciclo=True, chamada_padrao=2, origem='AUDITORIA_V8')
+            changed = closing.aplicar_chamada_padrao_competencia(con, '08/2026', [cid])
+            row = con.execute("SELECT status,chamada,impedimento_tipo FROM fechamento_mensal_cliente WHERE competencia='08/2026' AND cliente_id=?", (cid,)).fetchone()
+            self.assertEqual(changed, 1)
+            self.assertEqual((row['status'], row['chamada'], row['impedimento_tipo']), ('ADIADA', 2, 'CHAMADA_PADRAO'))
+            self.assertNotIn(cid, closing.clientes_conferencia_ids(con, '08/2026'))
+            con.close()
+
+
+if __name__ == '__main__':
+    unittest.main()
