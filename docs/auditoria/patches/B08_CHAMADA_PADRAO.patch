+def _disparar_saidas_automaticas(con: sqlite3.Connection, competencia: str, cliente_ids: list[int] | set[int]) -> None:
+    """Dispara saídas após o fechamento; falha de saída nunca desfaz o fechamento."""
+    from axiom_tools.modules.processing.output import gerar_saidas_cliente_competencia
+    for cid in sorted({int(x) for x in cliente_ids if int(x) > 0}):
+        try:
+            resultado=gerar_saidas_cliente_competencia(con,cid,competencia,automaticas=True)
+            _registrar(con,competencia,"SAIDA_AUTOMATICA_POS_FECHAMENTO",cid,detalhe=(
+                f"documentos={resultado.get('documentos',0)}; geradas={resultado.get('geradas',0)}; "
+                f"ignoradas={resultado.get('ignoradas',0)}; erros={resultado.get('erros',0)}"
+            ))
+        except Exception as exc:
+            _registrar(con,competencia,"SAIDA_AUTOMATICA_ERRO",cid,detalhe=str(exc)[:1000])
+    con.commit()
+
